NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# This implementation rejects every value except SANDBOX (case-insensitive).
PAYPAL_ENVIRONMENT=SANDBOX
# Fixture mode is the safe default and is always labeled in the UI.
PRICE_DISCOVERY_MODE=fixture
# Set channel3 for official semantic search. No silent fixture fallback occurs.
# Required only in channel3 mode. Keep server-side; never prefix NEXT_PUBLIC_.
CHANNEL3_API_KEY=
CHANNEL3_TIMEOUT_SECONDS=8
CHANNEL3_REQUESTS_PER_MINUTE=20
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
APP_ENV=development
PRICE_MATCHER_DATA_FILE=.data/price-intelligence.json
# Required in production to sign the HttpOnly anonymous-session cookie (32+ characters).
PRICE_MATCHER_SESSION_SECRET=
# Shared deployments must use PostgreSQL. Local mode is development/test only.
PERSISTENCE_BACKEND=local
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=4500
DATABASE_QUERY_TIMEOUT_MS=4000
DATABASE_STATEMENT_TIMEOUT_MS=4000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_HEALTH_TIMEOUT_MS=4800
DATABASE_SSL=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional custom CA bundle. On Render, prefer one base64-encoded Supabase CA.
DATABASE_SSL_CA_BASE64=
# Optional integration-test database with all committed migrations applied.
TEST_DATABASE_URL=
