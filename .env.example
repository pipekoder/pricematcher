NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# This implementation rejects every value except SANDBOX (case-insensitive).
PAYPAL_ENVIRONMENT=SANDBOX
# Optional explicit Sandbox-only demo proposal mode. Defaults off.
PRICEMATCHER_DEMO_ASSUMPTIONS=0
# Optional Muse Spark 1.3 dual-agent offers; requires the Sandbox assumption flag above.
# Set only in Vercel server-side secrets. This key uses Meta Model API credits.
MODEL_API_KEY=
AI_OFFER_AGENT_ENABLED=false
AI_OFFER_MAX_CALLS_PER_DAY=40
AI_OFFER_MAX_ESTIMATED_SPEND_USD=1
# Exact saved-product Channel3 lookup on Check Prices only; enable after budget migration.
CHANNEL3_EXACT_LOOKUP_ENABLED=0
CHANNEL3_EXACT_MAX_REQUESTS_PER_DAY=10
CHANNEL3_EXACT_TIMEOUT_SECONDS=8
# Merchant-controlled inventory floors. Markup may be 500 or 1000 basis points.
AI_OVERSTOCK_MARKUP_BPS=500
AI_ACTIVE_SALES_DAYS=3
# Protects internal simulated cost, stock and agent diagnostics.
MERCHANT_DEMO_ACCESS_TOKEN=
# Fixture mode is the safe default and is always labeled in the UI.
PRICE_DISCOVERY_MODE=fixture
# Set channel3 for official semantic search. No silent fixture fallback occurs.
# Required only in channel3 mode. Keep server-side; never prefix NEXT_PUBLIC_.
CHANNEL3_API_KEY=
CHANNEL3_TIMEOUT_SECONDS=8
CHANNEL3_REQUESTS_PER_MINUTE=20
APP_ENV=development
PRICE_MATCHER_DATA_FILE=.data/price-intelligence.json
# Required in production to sign the HttpOnly anonymous-session cookie (32+ characters).
PRICE_MATCHER_SESSION_SECRET=
# Shared deployments must use PostgreSQL. Local mode is development/test only.
PERSISTENCE_BACKEND=local
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=4500
DATABASE_QUERY_TIMEOUT_MS=4000
DATABASE_STATEMENT_TIMEOUT_MS=4000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_HEALTH_TIMEOUT_MS=4800
DATABASE_SSL=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional custom CA bundle. On Render, prefer one base64-encoded Supabase CA.
DATABASE_SSL_CA_BASE64=
# Optional integration-test database with all committed migrations applied.
TEST_DATABASE_URL=
